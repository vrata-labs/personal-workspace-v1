{
  "name": "@vrata/personal-workspace-v1",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-baked-release.mjs",
    "build:metadata": "node scripts/build-candidate.mjs",
    "build:release": "node scripts/build-baked-release.mjs",
    "manifest:check": "node scripts/validate-repository.mjs --manifest-only",
    "validate": "node scripts/validate-repository.mjs && node scripts/check-boundary.mjs",
    "validate:visual": "node scripts/validate-visual-parity.mjs",
    "inspect": "node scripts/inspect-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:reproducibility": "node scripts/verify-reproducibility.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "gltf-validator": "2.0.0-dev.3.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
